# Database (reads - direct MySQL/MariaDB connection)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dolibarr
DB_USER=dolibarr
DB_PASS=secret
DB_PREFIX=llx_

# Dolibarr REST API (writes - preserves business logic)
DOLIBARR_API_URL=https://erp.example.com/api/index.php
DOLIBARR_API_KEY=your_api_key_here

# MCP Server
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
MCP_AUTH_TOKEN=your_secret_token_here

# Dolibarr instance
DOLIBARR_ENTITY=1

# ── Connection pool and timeouts ──────────────────────────────────────────────
# Durations accept Go syntax ("30s", "5m") or a bare integer read as seconds.
# All of these have sane defaults; set them only when you need to.
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
# Recycle connections well before MySQL's wait_timeout so stale sockets never
# reach the pool.
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m
# Network bounds. Without these a host that stops answering TCP hangs a tool
# call until the OS gives up.
DB_CONNECT_TIMEOUT=5s
DB_READ_TIMEOUT=30s
DB_WRITE_TIMEOUT=30s
# Ceiling for a single search or get.
DB_QUERY_TIMEOUT=45s

# ── Read cache ────────────────────────────────────────────────────────────────
# Absorbs the duplicate reads an LLM caller produces while it reasons. Cleared
# in full after every successful write, so it can never serve data this server
# has already changed. Set CACHE_TTL=0 to turn it off.
CACHE_TTL=30s
CACHE_MAX_ENTRIES=500
